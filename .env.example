# Supabase Configuration (optional - app works without these in demo mode)
# Get these from https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# When these are NOT set, the app runs in Demo Mode using:
# - localStorage for persistence
# - BroadcastChannel for real-time across tabs
# - Simulated GPS movement for other family members
# Just open multiple browser tabs to simulate different family members!
